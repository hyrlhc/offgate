# OffGate — ornek ortam dosyasi. Kopyala: cp .env.example .env
# .env ASLA commit edilmez (.gitignore'da)

# --- Stellar Testnet ---
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# --- Anchor (TR Mock Anchor) ---
ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
USDC_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# USDC'nin Soroban (SAC) adresi — kontrat token transferlerinde bunu kullanir
USDC_SAC=

# --- Hesaplar (P1'de uretilecek) ---
ADMIN_PUBLIC=
ADMIN_SECRET=
OPERATOR_PUBLIC=
# Operatorun ham Ed25519 acik anahtari (32 bayt hex) — ESP32'ye gomulecek, gizli DEGIL
OPERATOR_PK_HEX=
OPERATOR_SECRET=
USER_PUBLIC=
USER_SECRET=

# --- Kontrat (P1'de deploy edilecek) ---
CONTRACT_ID=

# --- Demo parametreleri (karar K-3) ---
DEMO_EVENT_ID=FEST26
DEMO_DEPOSIT_TRY=500
DEMO_FARE_TRY_KURUS=10000
DEMO_MAX_USES=5
